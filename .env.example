PROJECT_NAME="Turnero Municipalidad de Armstrong"
BACKEND_CORS_ORIGINS=["http://localhost:3000", "https://turnos.armstrong.gob.ar"]

POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=turnero_db
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
# En producción (ej. Upstash): usar la connection string completa que empieza con rediss://
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

JWT_SECRET=supersecretjwtkeyforlocaldevelopment1234567890!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie de sesión: en producción (HTTPS) debe ser True; en desarrollo local (HTTP) False.
SESSION_COOKIE_SECURE=False
# Vigencia (en minutos) del token opaco de recuperación de contraseña (Redis).
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# URL pública del frontend, usada para construir el enlace de reseteo (logs en DEV).
APP_BASE_URL=http://localhost:3000
